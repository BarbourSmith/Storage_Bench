                }
              ]
            },
            {
              "atomType": "Input",
              "x": 0.025384615384615384,
              "y": 0.15384615384615385,
              "uniqueID": "id-213",
              "type": "geometry"
            },
            {
              "atomType": "Code",
              "x": 0.4854497354497354,
              "y": 0.36211699164345407,
              "uniqueID": "id-214",
              "ioValues": [
                {
                  "name": "shape",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "clearance",
                  "ioValue": 0
                },
                {
                  "name": "onlyMoveUp",
                  "ioValue": true
                }
              ],
              "interpreterVersion": 1,
              "code": "/**\n * Lift Above XY Plane\n *\n * Shifts the incoming geometry straight up in Z so its lowest point sits at\n * `clearance` above the XY plane (Z = 0).\n */\nfunction run(\n  shape: Assembly | undefined = undefined,\n  clearance: number = 0,\n  onlyMoveUp: boolean = true,\n): Assembly {\n  if (!shape) {\n    throw new Error(\"Connect geometry to the 'shape' input\");\n  }\n\n  // Find the lowest Z across every leaf of the assembly.\n  let minZ = Infinity;\n  shape.onLeafs((leaf) => {\n    const bounds = (leaf.geometry as any).boundingBox?.bounds;\n    // 3D bounds are [[x,y,z],[x,y,z]]; a 2D Drawing only has [[x,y],[x,y]]\n    if (bounds && bounds[0].length > 2) {\n      minZ = Math.min(minZ, bounds[0][2]);\n    }\n    return leaf;\n  });\n\n  if (!isFinite(minZ)) {\n    console.warn(\"No 3D geometry found - passing the input through unchanged\");\n    return shape;\n  }\n\n  // How far up to go to put the bottom of the part at `clearance`.\n  let dz = clearance - minZ;\n  if (onlyMoveUp && dz < 0) {\n    dz = 0; // already above the plane, leave it where it is\n  }\n  if (dz === 0) {\n    return shape;\n  }\n\n  console.log(`Lowest point at Z=${minZ}, lifting by ${dz}`);\n\n  const lifted = shape.onLeafs((leaf) => {\n    const moved = new Assembly(leaf); // keeps color, tags, bom, plane\n    moved.geometry = (leaf.geometry as any).translate(0, 0, dz);\n    return moved;\n  });\n\n  if (!lifted) {\n    throw new Error(\"Input assembly contained no geometry\");\n  }\n  return lifted;\n}",
              "compiledCode": "\"use strict\";\n/**\n * Lift Above XY Plane\n *\n * Shifts the incoming geometry straight up in Z so its lowest point sits at\n * `clearance` above the XY plane (Z = 0).\n */\nfunction run(shape = undefined, clearance = 0, onlyMoveUp = true) {\n    if (!shape) {\n        throw new Error(\"Connect geometry to the 'shape' input\");\n    }\n    // Find the lowest Z across every leaf of the assembly.\n    let minZ = Infinity;\n    shape.onLeafs((leaf) => {\n        const bounds = leaf.geometry.boundingBox?.bounds;\n        // 3D bounds are [[x,y,z],[x,y,z]]; a 2D Drawing only has [[x,y],[x,y]]\n        if (bounds && bounds[0].length > 2) {\n            minZ = Math.min(minZ, bounds[0][2]);\n        }\n        return leaf;\n    });\n    if (!isFinite(minZ)) {\n        console.warn(\"No 3D geometry found - passing the input through unchanged\");\n        return shape;\n    }\n    // How far up to go to put the bottom of the part at `clearance`.\n    let dz = clearance - minZ;\n    if (onlyMoveUp && dz < 0) {\n        dz = 0; // already above the plane, leave it where it is\n    }\n    if (dz === 0) {\n        return shape;\n    }\n    console.log(`Lowest point at Z=${minZ}, lifting by ${dz}`);\n    const lifted = shape.onLeafs((leaf) => {\n        const moved = new Assembly(leaf); // keeps color, tags, bom, plane\n        moved.geometry = leaf.geometry.translate(0, 0, dz);\n        return moved;\n    });\n    if (!lifted) {\n        throw new Error(\"Input assembly contained no geometry\");\n    }\n    return lifted;\n}\n"
            }
          ],
